; FriendSh3ep Installer Script
; For use with the standard Amiga 'Installer' tool (v43+).
;
; Installs:
;   - FriendSh3ep binary + icon  -> <dest>/
;   - themes/                    -> <dest>/themes/
;   - FriendSh3ep.guide          -> <dest>/
;   - FriendSh3ep.readme         -> <dest>/
;   - LICENSE                    -> <dest>/
;   - optionally webp.datatype   -> SYS:Classes/DataTypes/ + SYS:Devs/DataTypes/
;     (only offered when no WebP datatype is installed yet)
;
; FriendSh3ep itself needs EmojiGear v6.1 (utf8rastport.library,
; unitexteditor.gadget, unibutton.gadget) and AmiSSL v5 already installed --
; see the EmojiGear6.1.lha package and Aminet for AmiSSL. This installer does
; not bring those in; it only places FriendSh3ep and its own data.
;

(set #app-name    "FriendSh3ep")
(set #app-version "v1.1.338")
(set #app-default "sys:utilities")

; ---------------------------------------------------------------------------
; Welcome
; ---------------------------------------------------------------------------
(message
    (cat
        "Welcome to the " #app-name " " #app-version " installer!\n\n"
        #app-name " is a Mastodon/Fediverse client for AmigaOS 3.2.x.\n\n"
        "Before continuing, make sure you already have:\n"
        "  - EmojiGear v6.1 installed (utf8rastport.library,\n"
        "    unitexteditor.gadget, unibutton.gadget)\n"
        "  - AmiSSL v5 installed\n"
        "  - a working Internet stack\n\n"
        "Click Proceed to choose where to install " #app-name "."
    )
    (all)
)

; ---------------------------------------------------------------------------
; Choose installation directory
; ---------------------------------------------------------------------------
(set #parent
    (askdir
        (prompt
            (cat "Where would you like to install " #app-name "?")
        )
        (help
            (cat
                "Choose a drawer for the installation.\n"
                "A '" #app-name "' drawer will be created inside it.\n\n"
                "Default: " #app-default #app-name
            )
        )
        (default #app-default)
    )
)

(set #dest (tackon #parent #app-name))

(complete 10)

; ---------------------------------------------------------------------------
; Create destination drawer and install the binary + icon
; ---------------------------------------------------------------------------
(working (cat "Creating " #dest " ..."))
(makedir #dest)

(working "Copying FriendSh3ep ...")
(copyfiles
    (source "bin/FriendSh3ep")
    (dest #dest)
)

; The icon stores the app's saved settings in its tooltypes, so we only
; install it if it doesn't already exist -- an upgrade must never overwrite
; the user's settings.
(if (not (exists (tackon #dest "FriendSh3ep.info")))
    (
        (working "Copying FriendSh3ep icon ...")
        (copyfiles
            (source "bin/FriendSh3ep.info")
            (dest #dest)
        )
    )
)

(complete 40)

; ---------------------------------------------------------------------------
; Install themes/
; ---------------------------------------------------------------------------
(set #themes-dest (tackon #dest "themes"))
(working "Copying themes ...")
(makedir #themes-dest)
(copyfiles
    (source "themes")
    (dest #themes-dest)
    (all)
)

(complete 75)

; ---------------------------------------------------------------------------
; Documentation
; ---------------------------------------------------------------------------
(working "Copying documentation ...")
(copyfiles
    (source "FriendSh3ep.guide")
    (dest #dest)
    (infos)
)
(copyfiles
    (source "FriendSh3ep.readme")
    (dest #dest)
    (infos)
)
(copyfiles
    (source "LICENSE")
    (dest #dest)
)

(complete 100)

; ---------------------------------------------------------------------------
; Optional webp.datatype: many Mastodon images and avatars are WebP, and
; FriendSh3ep loads pictures through datatypes. Same copy as the WebPDT
; package's own Install_WebPDT script.
; ---------------------------------------------------------------------------
(set #webp-msg "")
(if (AND (exists "WebPDT/Classes/DataTypes/webp.datatype")
         (exists "WebPDT/Devs/DataTypes/WebP")
         (NOT (AND (exists "SYS:Devs/DataTypes/WebP")
                   (exists "SYS:Classes/DataTypes/webp.datatype"))))
    (if (askbool
            (prompt "\nYou don't seem to have a WebP image datatype.\n\n"
                    "Many pictures and avatars on Mastodon are WebP\n"
                    "images, " #app-name " can only show them with one.\n\n"
                    "Do you want to install one?\n\n"
                    "(free, BSD licensed webp.datatype for 68020+,\n"
                    "built on Google's libwebp)")
            (help "Copies webp.datatype to SYS:Classes/DataTypes/\n"
                  "and the WebP descriptor to SYS:Devs/DataTypes/.")
            (choices "Install" "Skip")
            (default 1)
        )
        (
            (working "Copying webp.datatype ...")
            (copyfiles
                (source "WebPDT/Devs/DataTypes/WebP")
                (dest "SYS:Devs/DataTypes")
                (infos)
                (nogauge)
            )
            (copyfiles
                (source "WebPDT/Classes/DataTypes/webp.datatype")
                (dest "SYS:Classes/DataTypes")
                (nogauge)
            )
            (if (AND (exists "SYS:Devs/DataTypes/WebP")
                     (exists "SYS:Classes/DataTypes/webp.datatype"))
                (
                    ; register the descriptor now, so no reboot is needed
                    (run "C:AddDataTypes SYS:Devs/DataTypes/WebP REFRESH")
                    (set #webp-msg "\n\nwebp.datatype installed and registered.\n(If WebP pictures still don't show, reboot.)")
                )
                (set #webp-msg "\n\nCopy failed: webp.datatype is NOT installed.")
            )
        )
    )
)

; ---------------------------------------------------------------------------
; Done!
; ---------------------------------------------------------------------------
(exit
    (cat
        "  * * *  Installation complete!  * * *\n\n"
        "Installed in:  " #dest "\n\n"
        "Remember, FriendSh3ep needs EmojiGear v6.1 and AmiSSL v5\n"
        "already installed on your system to run."
        #webp-msg
    )
    (quiet)
)
